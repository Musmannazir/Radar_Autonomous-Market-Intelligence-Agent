# ============================================
# Radar — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================

# --- Search (DuckDuckGo is free and works without a key) ---
# DuckDuckGo is used by default (no config needed).
# Optionally add Tavily for better extracted content:
TAVILY_API_KEY=

# --- LLM Provider ---
# "ollama" (local, free) or "groq" (free API, faster)
VERIFIER_PROVIDER=ollama

# Only needed if VERIFIER_PROVIDER=groq
GROQ_API_KEY=

# --- Email Delivery ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Cost Control ---
# Max LLM calls per run (default: 25)
MAX_LLM_CALLS_PER_RUN=25
# Max search calls per run (default: 20)
MAX_SEARCH_CALLS_PER_RUN=20

# --- LangSmith Tracing (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=false
